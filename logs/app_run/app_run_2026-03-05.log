 检查文件是否存在\n        if not os.path.exists(filename):\n            print(f"文件 {filename} 不存在")\n            return None\n        \n        with open(filename, \'r\', encoding=\'utf-8\') as file:\n            orders = file.readlines()\n        \n        print(f"从文件 {filename} 读取到的订单数据:")\n        for order in orders:\n            print(order.strip())\n        \n        return orders\n        \n    except Exception as e:\n        print(f"读取文件失败: {e}")\n        return None\n\n\ndef main():\n    """主函数 - 演示脚本使用方法"""\n    print("=== 订单数据写入演示 ===")\n    \n    # 定义订单数据\n    order_id = "1002"\n    total_amount = 7499.0\n    filename = "orders.txt"\n    \n    print(f"要写入的订单数据:")\n    print(f"  订单号: {order_id}")\n    print(f"  总金额: {total_amount}元")\n    print(f"  目标文件: {filename}")\n    print()\n    \n    # 写入订单数据\n    success = write_order_to_file(order_id, total_amount, filename)\n    \n    if success:\n        print("\\n写入成功！正在验证写入结果...")\n        # 读取并显示文件内容以验证写入结果\n        read_orders_from_file(filename)\n    else:\n        print("\\n写入失败！")\n\n\nif __name__ == "__main__":\n    # 运行主函数\n    main()\n```\n\n**脚本功能说明：**\n- 自动将订单号1002和总金额7499.0元写入到"orders.txt"文件\n- 支持追加模式，不会覆盖已有订单记录\n- 包含数据验证和错误处理机制\n- 提供读取功能用于验证写入结果\n\n您只需运行此脚本，即可在当前目录生成包含订单信息的文件。', 'refusal': None, 'role': 'assistant', 'annotations': None, 'audio': None, 'function_call': None, 'tool_calls': []}}][0m
