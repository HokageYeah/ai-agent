  \n    except PermissionError:\n        print(f"❌ 权限错误: 没有写入文件 {filename} 的权限")\n        return False\n        \n    except Exception as e:\n        print(f"❌ 发生未知错误: {e}")\n        return False\n\ndef main():\n    """主函数"""\n    print("=" * 50)\n    print("       订单数据写入工具")\n    print("=" * 50)\n    \n    # 定义订单数据\n    order_number = "1002"\n    order_amount = 7499.0\n    output_file = "order_1002.txt"\n    \n    print(f"📋 订单信息:")\n    print(f"   订单号: {order_number}")\n    print(f"   订单金额: {order_amount:.2f}元")\n    print(f"   输出文件: {output_file}")\n    print("-" * 50)\n    \n    # 执行写入操作\n    success = write_order_amount(order_number, order_amount, output_file)\n    \n    if success:\n        print("\\n🎉 操作完成！订单数据已成功保存。")\n    else:\n        print("\\n💥 操作失败！请检查错误信息并重试。")\n        sys.exit(1)\n\nif __name__ == "__main__":\n    main()\n```\n\n**脚本功能说明：**\n- **写入内容**：订单号: 1002, 订单总金额: 7499.00元\n- **输出文件**：order_1002.txt\n- **执行效果**：脚本运行后会显示详细的执行状态，包括文件创建验证和内容确认\n- **错误处理**：包含完整的异常处理机制，确保操作可靠性\n\n运行此脚本后，您将在当前目录获得包含订单数据的文本文件。', 'refusal': None, 'role': 'assistant', 'annotations': None, 'audio': None, 'function_call': None, 'tool_calls': []}}][0m
