turn False, f"没有权限创建目录: {directory}"\n        \n        # 检查文件写入权限\n        if os.path.exists(file_path):\n            if not os.access(file_path, os.W_OK):\n                return False, f"没有写入文件的权限: {file_path}"\n        else:\n            # 检查目录写入权限\n            directory = os.path.dirname(file_path) or \'.\'\n            if not os.access(directory, os.W_OK):\n                return False, f"没有在目录 {directory} 创建文件的权限"\n        \n        return True, "权限检查通过"\n    \n    except Exception as e:\n        return False, f"权限检查失败: {str(e)}"\n\ndef write_order_to_file(order_id: str, total_amount: Union[int, float, str], file_path: str) -> tuple[bool, str]:\n    """\n    将订单数据写入文件\n    \n    Args:\n        order_id: 订单ID\n        total_amount: 订单总金额\n        file_path: 文件路径\n        \n    Returns:\n        tuple: (是否成功, 错误信息)\n    """\n    try:\n        # 数据验证\n        is_valid, validation_msg = validate_order_data(order_id, total_amount)\n        if not is_valid:\n            return False, f"数据验证失败: {validation_msg}"\n        \n        # 权限检查\n        has_permission, permission_msg = check_file_permissions(file_path)\n        if not has_permission:\n            return False, f"权限检查失败: {permission_msg}"\n        \n        # 写入文件\n        with open(file_path, \'w\', encoding=\'utf-8\') as f:\n            f.write(f"订单号: {order_id}\\\\n")\n            f.write(f"订单总金额: {float(total_amount):.2f}元\\\\n")\n            f.write(f"写入时间: {__import__(\'datetime\').datetime.now().strftime(\'%Y-%m-%d %H:%M:%S\')}\\\\n")\n        \n        return True, f"订单数据已成功写入文件: {file_path}"\n    \n    except Exception as e:\n        return False, f"写入文件失败: {str(e)}"\n\ndef main():\n    """\n    主函数\n    """\n    # 订单数据\n    order_id = "1002"\n    total_amount = 7499.0\n    file_path = "order_1002.txt"\n    \n    print("=" * 50)\n    print("订单数据写入脚本")\n    print("=" * 50)\n    print(f"订单号: {order_id}")\n    print(f"订单总金额: {total_amount}元")\n    print(f"目标文件: {file_path}")\n    print()\n    \n    # 