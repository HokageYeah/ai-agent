   raise PermissionError(f"没有权限创建目录: {self.output_dir}")\n        \n        # 检查目录写入权限\n        if not os.access(self.output_dir, os.W_OK):\n            raise PermissionError(f"没有写入目录的权限: {self.output_dir}")\n        \n        # 检查文件是否已存在，如果存在则检查写入权限\n        if self.file_path.exists():\n            if not os.access(self.file_path, os.W_OK):\n                raise PermissionError(f"没有写入文件的权限: {self.file_path}")\n        \n        logger.info("权限检查通过")\n    \n    def validate_data_integrity(self):\n        """验证数据完整性"""\n        logger.info("验证数据完整性...")\n        \n        # 检查订单号格式\n        if not self.order_id.isdigit():\n            logger.warning(f"订单号包含非数字字符: {self.order_id}")\n        \n        # 检查金额格式\n        if not isinstance(self.order_amount, (int, float)):\n            raise ValueError("订单金额格式不正确")\n        \n        logger.info("数据完整性验证通过")\n    \n    def write_order_data(self):\n        """写入订单数据到文件"""\n        logger.info(f"开始写入订单数据到文件: {self.file_path}")\n        \n        try:\n            # 准备写入的数据\n            order_data = f"订单号: {self.order_id}\\n订单总金额: {self.order_amount}元\\n"\n            \n            # 写入文件\n            with open(self.file_path, \'w\', encoding=\'utf-8\') as file:\n                file.write(order_data)\n            \n            # 验证文件是否成功写入\n            if not self.file_path.exists():\n                raise IOError(f"文件写入失败: {self.file_path}")\n            \n            # 读取并验证写入的内容\n            with open(self.file_path, \'r\', encoding=\'utf-8\') as file:\n                content = file.read()\n                expected_content = f"订单号: {self.order_id}\\n订单总金额: {self.order_amount}元\\n"\n                if content != expected_content:\n                    raise ValueError("写入的文件内容与预期不符")\n            \n            logger.info(f"订单数据成功写入文件: {self.file_path}")\n            return True\n            \n        except IOError as e:\n            logger.error(f"文件IO错误: {e}")\n            raise\n        except Exception as e:\n            logger.error(f"写入文件时发生未知错误: {e}")\n            raise\n    \n    def execute(self):\n        """执行完整的订单写入流程"""\n        try:\n            logger.info("开始执行订单数据写入流程")\n            \n            # 执行验证和检查\n            self.validate_inputs()\n            self.check_permissions()\n            self.validate_data_integrity()\n            \n            # 写入数据\n            success = self.write_order_data()\n            \n            if success:\n                logger.info("订单数据写入流程完成")\n                return True\n            else:\n                logger.error("订单数据写入流程失败")\n                return False\n                \n        except Exception as e:\n            logger.error(f"订单数据写入流程失败: {e}")\n            return False\n\ndef main():\n    """主函数"""\n    try:\n        # 订单数据\n        ORDER_ID = "1002"\n        ORDER_AMOUNT = 7499.0\n        \n        # 创建订单写入器实例\n        order_writer = OrderWriter(ORDER_ID, ORDER_AMOUNT)\n        \n        # 执行写入流程\n        success = order_writer.execute()\n        \n        if success:\n            print(f"✅ 订单数据成功写入文件: order_{ORDER_ID}.txt")\n            print(f"   订单号: {ORDER_ID}")\n            print(f"   订单金额: {ORDER_AMOUNT}元")\n            sys.exit(0)\n        else:\n            print("❌ 订单数据写入失败")\n            sys.exit(1)\n            \n    except KeyboardInterrupt:\n        logger.info("用户中断执行")\n        print("\\n❌ 用户中断执行")\n        sys.exit(1)\n    except Exception as e:\n        logger.error(f"程序执行失败: {e}")\n        print(f"❌ 程序执行失败: {e}")\n        sys.exit(1)\n\nif __name__ == "__main__":\n    main()\n```\n\n这个Python脚本提供了以下功能：\n\n## 主要特性\n\n1. **完整的错误处理**：\n   - 输入参数验证\n   - 文件权限检查\n   - IO异常处理\n   - 数据完整性验证\n\n2. **权限检查**：\n   - 目录写入权限验证\n   - 文件写入权限验证\n   - 目录自动创建（如果需要）\n\n3. **数据验证**：\n   - 订单号格式检查\n   - 订单金额类型和范围验证\n   - 写入后内容验证\n\n4. **日志记录**：\n   - 详细的执行日志\n   - 错误和警告信息\n\n5. **用户友好的输出**：\n   - 清晰的执行状态提示\n   - 适当的退出代码\n\n## 使用方法\n\n1. 将代码保存为 `order_writer.py`\n2. 直接运行：`python order_writer.py`\n3. 脚本会在当前目录生成 `order_1002.txt` 文件\n\n## 输出文件内容\n```\n订单号: 1002\n订单总金额: 7499.0元\n```\n\n脚本会处理各种异常情况，并提供详细的错误信息，确保数据安全可靠地写入文件。', 'refusal': None, 'role': 'assistant', 'annotations': None, 'audio': None, 'function_call': None, 'tool_calls': []}}][0m
