.path.dirname(file_path) or \'.\'\n            if not os.access(directory, os.W_OK):\n                return False, f"没有在目录 {directory} 创建文件的权限"\n        \n        return True, "权限检查通过"\n    \n    except Exception as e:\n        return False, f"权限检查失败: {str(e)}"\n\ndef write_order_to_file(order_id: str, total_amount: Union[int, float, str], file_path: str) -> tuple[bool, str]:\n    """\n    将订单数据写入文件\n    \n    Args:\n        order_id: 订单ID\n        total_amount: 订单总金额\n        file_path: 文件路径\n        \n    Returns:\n        tuple: (是否成功, 错误信息)\n    """\n    try:\n        # 数据验证\n        is_valid, validation_msg = validate_order_data(order_id, total_amount)\n        if not is_valid:\n            return False, f"数据验证失败: {validation_msg}"\n        \n        # 权限检查\n        has_permission, permission_msg = check_file_permissions(file_path)\n        if not has_permission:\n            return False, f"权限检查失败: {permission_msg}"\n        \n        # 写入文件\n        with open(file_path, \'w\', encoding=\'utf-8\') as file:\n            file.write(f"订单ID: {order_id}\\n")\n            file.write(f"总金额: {float(total_amount):.2f}元\\n")\n        \n        print(f"成功将订单 {order_id} 的总金额 {total_amount} 元写入文件: {file_path}")\n        return True, "写入成功"\n        \n    except IOError as e:\n        return False, f"文件IO错误: {str(e)}"\n    except PermissionError as e:\n        return False, f"文件权限错误: {str(e)}"\n    except Exception as e:\n        return False, f"写入文件时发生未知错误: {str(e)}"\n\ndef main():\n    """主函数"""\n    # 订单数据\n    order_id = "1002"\n    total_amount = 7499.0\n    file_path = "order_1002.txt"\n    \n    print("开始写入订单数据...")\n    print(f"订单ID: {order_id}")\n    print(f"总金额: {total_amount}元")\n    print(f"目标文件: {file_path}")\n    print("-" * 50)\n    \n    # 写入文件\n    success, message = write_order_to_file(order_id, total_amount, file_path)\n    \n    if success:\n        print(f"✅ {message}")\n        sys.exit(0)\n    else:\n        print(f"❌ {message}")\n        sys.exit(1)