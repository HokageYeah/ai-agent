n# 计算额外的统计指标\nmean_count = df_status[\'count\'].mean()\nmedian_count = df_status[\'count\'].median()\nstd_count = df_status[\'count\'].std()\ncv_count = std_count / mean_count * 100  # 变异系数\n\nprint(f"\\n详细统计指标:")\nprint(f"平均值: {mean_count:.2f}")\nprint(f"中位数: {median_count:.2f}")\nprint(f"标准差: {std_count:.2f}")\nprint(f"变异系数: {cv_count:.2f}%")\n\n# 计算各状态占比\ndf_status[\'percentage\'] = (df_status[\'count\'] / total_orders * 100).round(2)\nprint(f"\\n各状态分布百分比:")\nfor _, row in df_status.iterrows():\n    print(f"{row[\'status\']}: {row[\'count\']} 单 ({row[\'percentage\']}%)")\n\nprint("\\n3. 趋势分析")\nprint("-" * 40)\n\n# 订单状态分布分析\nprint("订单状态分布分析:")\n# 按订单数量排序\ndf_sorted = df_status.sort_values(\'count\', ascending=False)\n\nprint("\\n订单状态排名:")\nfor i, (_, row) in enumerate(df_sorted.iterrows(), 1):\n    print(f"{i}. {row[\'status\']}: {row[\'count\']} 单")\n\n# 计算集中度指标\ntop_status_share = df_sorted.iloc[0][\'percentage\']\ntop_2_status_share = df_sorted.iloc[0:2][\'percentage\'].sum()\n\nprint(f"\\n集中度分析:")\nprint(f"最高状态占比: {top_status_share}% (已交付)")\nprint(f"前两大状态占比: {top_2_status_share}% (已交付 + 已发货)")\n\n# 订单流程分析\nprint("\\n4. 异常检测")\nprint("-" * 40)\n\n# 使用Z-score检测异常值\ndef detect_outliers_zscore(data, threshold=2):\n    mean = np.mean(data)\n    std = np.std(data)\n    z_scores = [(x - mean) / std for x in data]\n    outliers = [i for i, z in enumerate(z_scores) if abs(z) > threshold]\n    return outliers, z_scores\n\noutliers, z_scores = detect_outliers_zscore(df_status[\'count\'])\nprint("Z-score异常检测:")\nfor i, z in enumerate(z_scores):\n    status = df_status.iloc[i][\'status\']\n    count = df_status.iloc[i][\'count\']\n    is_outlier = "*** 异常值 ***" if i in outliers else "正常"\n    print(f"{status}: Z-score = {z:.2f} - {is_outlier}")\n\n# 使用IQR方法检测异常值\ndef detect_outliers_iqr(data):\n    Q1 = np.percentile(data, 25)\n    Q3 = np.percentile(data, 75)\n    IQR = Q3 - Q1\n    lower_bound = Q1 - 1.5 * IQR\n    upper_bound = Q3 + 1.5 * IQR\n    outliers = [i for i, x in enumerate(data) if x < lower_bound or x > upper_bound]\n    return outliers, (lower_bound, upper_bound)\n\niqr_outliers, bounds = detect_outliers_iqr(df_status[\'count\'])\nprint(f"\\nIQR异常检测 (边界: [{bounds[0]:.2f}, {bound\n...（内容已截断）\n\n请根据以上数据，用清晰、友好的自然语言回答用户的任务需求。\n要求：\n1. 直接给出具体数据，不要使用 [xxx] 这样的占位符\n2. 信息完整，涵盖用户关心的所有字段\n3. 格式清晰，必要时使用列表或分段展示\n4. 如果数据中有错误或空值，如实告知\n\n请直接输出最终回答，不要包含任何前缀说明。'}], 'model': 'deepseek-v3.2', 'max_tokens': 4096, 'stream': False, 'temperature': 0.3}}
