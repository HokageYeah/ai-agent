\': missing_percent\n        })\n        print(missing_df[missing_df[\'缺失数量\'] > 0])\n    \n    def statistical_analysis(self):\n        """\n        统计分析\n        """\n        print("\\n" + "=" * 50)\n        print("统计分析")\n        print("=" * 50)\n        \n        if self.numeric_columns:\n            for col in self.numeric_columns:\n                print(f"\\n--- {col} ---")\n                print(f"均值: {self.data[col].mean():.2f}")\n                print(f"中位数: {self.data[col].median():.2f}")\n                print(f"标准差: {self.data[col].std():.2f}")\n                print(f"最小值: {self.data[col].min():.2f}")\n                print(f"最大值: {self.data[col].max():.2f}")\n                print(f"偏度: {self.data[col].skew():.2f}")\n                print(f"峰度: {self.data[col].kurtosis():.2f}")\n    \n    def trend_analysis(self):\n        """\n        趋势分析\n        """\n        print("\\n" + "=" * 50)\n        print("趋势分析")\n        print("=" * 50)\n        \n        # 检查是否有时间序列数据\n        date_columns = self.data.select_dtypes(include=[\'datetime64\']).columns.tolist()\n        \n        if date_columns and self.numeric_columns:\n            # 如果有时间列和数值列，进行时间序列分析\n            time_col = date_columns[0]\n            for num_col in self.numeric_columns[:2]:  # 分析前两个数值列\n                plt.figure(figsize=(12, 6))\n                plt.plot(self.data[time_col], self.data[num_col])\n                plt.title(f\'{num_col} 随时间变化趋势\')\n                plt.xlabel(\'时间\')\n                plt.ylabel(num_col)\n                plt.xticks(rotation=45)\n                plt.tight_layout()\n           \n...（内容已截断）\n\n请根据以上数据，用清晰、友好的自然语言回答用户的任务需求。\n要求：\n1. 直接给出具体数据，不要使用 [xxx] 这样的占位符\n2. 信息完整，涵盖用户关心的所有字段\n3. 格式清晰，必要时使用列表或分段展示\n4. 如果数据中有错误或空值，如实告知\n\n请直接输出最终回答，不要包含任何前缀说明。'}], 'model': 'deepseek-v3.2', 'max_tokens': 4096, 'stream': False, 'temperature': 0.3}}
