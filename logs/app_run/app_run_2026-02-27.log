订单金额: {order_amount}元\\")\\n        print(f\\"  退款金额: {refund_amount}元\\")\\n        print(f\\"  退款比例: {refund_ratio:.1f}%\\")\\n\\nprint(\\"\\\\n=== 异常值检测 ===\\")\\n\\n# 退款金额异常检测\\nrefund_amounts = [refund[\'amount\'] for refund in refunds_data]\\nmean_amount = statistics.mean(refund_amounts)\\nif len(refund_amounts) > 1:\\n    stdev_amount = statistics.stdev(refund_amounts)\\n    \\n    for i, amount in enumerate(refund_amounts):\\n        z_score = abs(amount - mean_amount) / stdev_amount\\n        if z_score > 1.5:\\n            print(f\\"退款ID {refunds_data[i][\'id\']} 金额异常 (Z-score: {z_score:.2f})\\")\\n            print(f\\"  金额: {amount}元, 平均值: {mean_amount:.2f}元\\")\\n\\n# 处理时长异常检测\\nif len(valid_process_times) > 1:\\n    mean_process_time = statistics.mean(valid_process_times)\\n    stdev_process_time = statistics.stdev(valid_process_times)\\n    \\n    for i, time in enumerate(valid_process_times):\\n        z_score = abs(time - mean_process_time) / stdev_process_time\\n        if z_score > 1.5:\\n            print(f\\"退款ID {refunds_data[i][\'id\']} 处理时长异常 (Z-score: {z_score:.2f})\\")\\n            print(f\\"  处理时长: {time:.1f}小时, 平均值: {mean_process_time:.1f}小时\\")"}', 'name': 'python_executor'}, 'type': 'function', 'index': 0}]}}][0m
