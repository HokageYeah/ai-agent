ivot:\\n            i += 1\\n            arr[i], arr[j] = arr[j], arr[i]\\n    \\n    arr[i + 1], arr[high] = arr[high], arr[i + 1]\\n    return i + 1\\n\\ndef test_quicksort():\\n    \\"\\"\\"\\n    测试快速排序算法的正确性\\n    \\"\\"\\"\\n    print(\\"=\\" * 50)\\n    print(\\"快速排序算法测试\\")\\n    print(\\"=\\" * 50)\\n    \\n    # 测试用例1: 空列表\\n    print(\\"\\\\n测试用例1: 空列表\\")\\n    arr1 = []\\n    result1 = quicksort(arr1)\\n    print(f\\"输入: {arr1}\\")\\n    print(f\\"输出: {result1}\\")\\n    print(f\\"测试结果: {\'✓ 通过\' if result1 == [] else \'✗ 失败\'}\\")\\n    \\n    # 测试用例2: 单个元素\\n    print(\\"\\\\n测试用例2: 单个元素\\")\\n    arr2 = [5]\\n    result2 = quicksort(arr2)\\n    print(f\\"输入: {arr2}\\")\\n    print(f\\"输出: {result2}\\")\\n    print(f\\"测试结果: {\'✓ 通过\' if result2 == [5] else \'✗ 失败\'}\\")\\n    \\n    # 测试用例3: 已排序的列表\\n    print(\\"\\\\n测试用例3: 已排序的列表\\")\\n    arr3 = [1, 2, 3, 4, 5]\\n    result3 = quicksort(arr3)\\n    print(f\\"输入: {arr3}\\")\\n    print(f\\"输出: {result3}\\")\\n    print(f\\"测试结果: {\'✓ 通过\' if result3 == [1, 2, 3, 4, 5] else \'✗ 失败\'}\\")\\n    \\n    # 测试用例4: 逆序列表\\n    print(\\"\\\\n测试用例4: 逆序列表\\")\\n    arr4 = [5, 4, 3, 2, 1]\\n    result4 = quicksort(arr4)\\n    print(f\\"输入: {arr4}\\")\\n    print(f\\"输出: {result4}\\")\\n    print(f\\"测试结果: {\'✓ 通过\' if result4 == [1, 2, 3, 4, 5] else \'✗ 失败\'}\\")\\n    \\n    # 测试用例5: 包含重复元素的列表\\n    print(\\"\\\\n测试用例5: 包含重复元素的列表\\")\\n    arr5 = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3, 5]\\n    result5 = quicksort(arr5)\\n    print(f\\"输入: {arr5}\\")\\n    print(f\\"输出: {result5}\\")\\n    expected5 = sorted(arr5)\\n    print(f\\"测试结果: {\'✓ 通过\' if result5 == expected5 else \'✗ 失败\'}\\")\\n    \\n    # 测试用例6: 随机生成的列表\\n    print(\\"\\\\n测试用例6: 随机生成的列表\\")\\n    random.seed(42)  # 设置随机种子以保证结果可重复\\n    arr6 = [random.randint(1, 100) for _ in range(10)]\\n    result6 = quicksort(arr6)\\n    print(f\\"输入: {arr6}\\")\\n    print(f\\"输出: {result6}\\")\\n    expected6 = sorted(arr6)\\n    print(f\\"测试结果: {\'✓ 通过\' if result6