},\\n    {\\"id\\": 1008, \\"customer_id\\": 3, \\"total_amount\\": 528.0, \\"paid_amount\\": 0.0, \\"discount_amount\\": 0.0, \\"status\\": \\"cancelled\\", \\"payment_status\\": \\"unpaid\\", \\"payment_method\\": None},\\n    {\\"id\\": 1004, \\"customer_id\\": 4, \\"total_amount\\": 11798.0, \\"paid_amount\\": 11798.0, \\"discount_amount\\": 0.0, \\"status\\": \\"confirmed\\", \\"payment_status\\": \\"paid\\", \\"payment_method\\": \\"creditcard\\"},\\n    {\\"id\\": 1010, \\"customer_id\\": 5, \\"total_amount\\": 129.0, \\"paid_amount\\": 129.0, \\"discount_amount\\": 0.0, \\"status\\": \\"delivered\\", \\"payment_status\\": \\"paid\\", \\"payment_method\\": \\"wechat\\"},\\n    {\\"id\\": 1006, \\"customer_id\\": 1, \\"total_amount\\": 9999.0, \\"paid_amount\\": 9999.0, \\"discount_amount\\": 0.0, \\"status\\": \\"shipped\\", \\"payment_status\\": \\"paid\\", \\"payment_method\\": \\"alipay\\"},\\n    {\\"id\\": 1009, \\"customer_id\\": 4, \\"total_amount\\": 399.0, \\"paid_amount\\": 359.0, \\"discount_amount\\": 40.0, \\"status\\": \\"pending\\", \\"payment_status\\": \\"paid\\", \\"payment_method\\": \\"alipay\\"}\\n]\\n\\nprint(\\"=== 订单数据分析报告 ===\\\\n\\")\\n\\n# 1. 数据概览\\nprint(\\"1. 数据概览\\")\\nprint(f\\"总订单数: {len(orders_data)}\\")\\nprint(f\\"字段数量: 14个字段\\")\\nprint(f\\"时间范围: 2026-02-01 至 2026-02-22\\")\\n\\n# 提取数值字段\\namounts = [order[\'total_amount\'] for order in orders_data]\\npaid_amounts = [order[\'paid_amount\'] for order in orders_data]\\ndiscounts = [order[\'discount_amount\'] for order in orders_data]\\n\\n# 基本统计分析\\nprint(\\"\\\\n2. 统计分析\\")\\nprint(f\\"订单金额统计:\\")\\nprint(f\\"  - 最小值: {min(amounts):.2f}\\")\\nprint(f\\"  - 最大值: {max(amounts):.2f}\\")\\nprint(f\\"  - 平均值: {sum(amounts)/len(amounts):.2f}\\")\\nprint(f\\"  - 中位数: {sorted(amounts)[len(amounts)//2]:.2f}\\")\\n\\n# 标准差计算\\nmean_amount = sum(amounts) / len(amounts)\\nvariance = sum((x - mean_amount) ** 2 for x in amounts) / len(amounts)\\nstd_dev = variance ** 0.5\\nprint(f\\"  - 标