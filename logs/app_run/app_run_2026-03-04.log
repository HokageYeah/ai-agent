准差: {std_dev:.2f}\\")\\n\\n# 订单状态分布\\nstatus_counts = {}\\nfor order in orders_data:\\n    status = order[\'status\']\\n    status_counts[status] = status_counts.get(status, 0) + 1\\n\\nprint(f\\"\\\\n订单状态分布:\\")\\nfor status, count in status_counts.items():\\n    percentage = (count / len(orders_data)) * 100\\n    print(f\\"  - {status}: {count} 单 ({percentage:.1f}%)\\")\\n\\n# 支付方式分布\\npayment_counts = {}\\nfor order in orders_data:\\n    method = order[\'payment_method\'] or \'none\'\\n    payment_counts[method] = payment_counts.get(method, 0) + 1\\n\\nprint(f\\"\\\\n支付方式分布:\\")\\nfor method, count in payment_counts.items():\\n    percentage = (count / len(orders_data)) * 100\\n    print(f\\"  - {method}: {count} 单 ({percentage:.1f}%)\\")\\n\\n# 3. 趋势分析\\nprint(\\"\\\\n3. 趋势分析\\")\\n\\n# 按日期分析订单量趋势\\ndates = [\\"02-01\\", \\"02-05\\", \\"02-08\\", \\"02-10\\", \\"02-12\\", \\"02-14\\", \\"02-15\\", \\"02-16\\", \\"02-18\\", \\"02-22\\"]\\nprint(f\\"订单日期分布:\\")\\nfor i, date in enumerate(dates):\\n    print(f\\"  - {date}: 订单 #{orders_data[i][\'id\']}, 金额 {orders_data[i][\'total_amount\']:.2f}\\")\\n\\n# 计算日均订单量\\ndaily_orders = {}\\nfor i, order in enumerate(orders_data):\\n    date = dates[i]\\n    daily_orders[date] = daily_orders.get(date, 0) + 1\\n\\nprint(f\\"\\\\n日均订单量: {len(orders_data)/len(daily_orders):.1f}\\")\\n\\n# 4. 异常检测\\nprint(\\"\\\\n4. 异常检测\\")\\n\\n# 使用IQR方法检测异常值\\nq1 = sorted(amounts)[len(amounts)//4]\\nq3 = sorted(amounts)[3*len(amounts)//4]\\niqr = q3 - q1\\nlower_bound = q1 - 1.5 * iqr\\nupper_bound = q3 + 1.5 * iqr\\n\\noutliers = [order for order in orders_data if order[\'total_amount\'] < lower_bound or order[\'total_amount\'] > upper_bound]\\n\\nprint(f\\"异常值检测 (IQR方法):\\")\\nprint(f\\"  - Q1: {q1:.2f}\\")\\nprint(f\\"  - Q3: {q3:.2f}\\")\\nprint(f\\"  - IQR: {iqr:.2f}\\")\\nprint(f\\"  - 异常阈值: [{lower_bound:.2f}, {upper_bound:.2f}]\\")\\nprint(f\\"  - 检测到异常订单: {len(outliers)} 单\\")\\n\\nfor outlier in outliers:\\n    print(f\\"    * 订单