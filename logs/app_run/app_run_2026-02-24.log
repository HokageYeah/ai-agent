unt\'].median()}")\nprint(f"订单数标准差: {df[\'count\'].std():.2f}")\nprint(f"订单数最大值: {df[\'count\'].max()}")\nprint(f"订单数最小值: {df[\'count\'].min()}")\nprint(f"订单数变异系数: {(df[\'count\'].std() / df[\'count\'].mean()):.2f}")\n\nprint("\\n3. 分布分析")\nprint("-" * 30)\n# 计算百分比\ndf[\'percentage\'] = (df[\'count\'] / df[\'count\'].sum() * 100).round(2)\ndf[\'cumulative_percentage\'] = df[\'percentage\'].cumsum()\n\nprint("各状态订单分布:")\nfor index, row in df.iterrows():\n    print(f"  {row[\'status\']}: {row[\'count\']} 单 ({row[\'percentage\']}%)")\n\nprint(f"\\n已完成订单比例: {(df[df[\'status\'].isin([\'delivered\'])][\'count\'].sum() / df[\'count\'].sum() * 100):.1f}%")\nprint(f"进行中订单比例: {(df[df[\'status\'].isin([\'confirmed\', \'pending\', \'shipped\'])][\'count\'].sum() / df[\'count\'].sum() * 100):.1f}%")\nprint(f"取消订单比例: {(df[df[\'status\'].isin([\'cancelled\'])][\'count\'].sum() / df[\'count\'].sum() * 100):.1f}%")\n\nprint("\\n4. 趋势和模式分析")\nprint("-" * 30)\n# 按订单数排序\ndf_sorted = df.sort_values(\'count\', ascending=False)\nprint("订单状态按数量排序:")\nfor index, row in df_sorted.iterrows():\n    print(f"  {row[\'status\']}: {row[\'count\']} 单")\n\n# 帕累托分析\nprint(f"\\n帕累托分析:")\ntop_status = df_sorted.iloc[0]\nprint(f"  最主要状态 \'{top_status[\'status\']}\' 占总订单的 {top_status[\'percentage\']}%")\n\n# 计算80/20法则\ncumulative_sum = 0\nfor i, row in enumerate(df_sorted.itertuples()):\n    cumulative_sum += row.count\n    percentage = (cumulative_sum / df[\'count\'].sum()) * 100\n    if percentage >= 80:\n        print(f"  前{i+1}个状态占据了{percentage:.1f}%的订单")\n        break\n\nprint("\\n5. 异常值检测")\nprint("-" * 30)\n# 使用Z-score检测异常值\nz_scores = np.abs(stats.zscore(df[\'count\']))\noutliers = df[z_scores > 1.5]\n\nif len(outliers) > 0:\n    print("检测到的异常值:")\n    for index, row in outliers.iterrows():\n        z_score = z_scores[index]\n        print(f"  {row[\'status\']}: {row[\'count\']} 单 (Z-score: {z_score:.2f})")\nelse:\n    print("未检测到明显的统计异常值")\n\n# 业务逻辑异常检测\nprint("\\n业务异常分析:")\nif df[df[\'status\'