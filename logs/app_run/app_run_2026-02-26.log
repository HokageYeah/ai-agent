/**
 * 带搜索和分页功能的用户列表组件
 */

// 模拟用户数据
const mockUsers = [
  { id: 1, name: '张三', email: 'zhangsan@example.com', role: '管理员' },
  { id: 2, name: '李四', email: 'lisi@example.com', role: '用户' },
  { id: 3, name: '王五', email: 'wangwu@example.com', role: '用户' },
  { id: 4, name: '赵六', email: 'zhaoliu@example.com', role: '编辑' },
  { id: 5, name: '钱七', email: 'qianqi@example.com', role: '用户' },
  { id: 6, name: '孙八', email: 'sunba@example.com', role: '管理员' },
  { id: 7, name: '周九', email: 'zhoujiu@example.com', role: '用户' },
  { id: 8, name: '吴十', email: 'wushi@example.com', role: '编辑' },
  { id: 9, name: '郑十一', email: 'zhengshiyi@example.com', role: '用户' },
  { id: 10, name: '王十二', email: 'wangshier@example.com', role: '用户' }
];

/**
 * 用户列表组件
 */
function UserList() {
  // 状态管理
  const [users, setUsers] = React.useState([]); // 用户列表数据
  const [filteredUsers, setFilteredUsers] = React.useState([]); // 过滤后的用户列表
  const [searchTerm, setSearchTerm] = React.useState(''); // 搜索关键词
  const [currentPage, setCurrentPage] = React.useState(1); // 当前页码
  const [itemsPerPage] = React.useState(5); // 每页显示数量
  const [loading, setLoading] = React.useState(true); // 加载状态
  const [error, setError] = React.useState(null); // 错误信息

  // 组件挂载时加载数据
  React.useEffect(() => {
    loadUsers();
  }, []);

  // 搜索和分页变化时更新过滤后的数据
  React.useEffect(() => {
    filterAndPaginateUsers();
  }, [users, searchTerm, currentPage]);

  /**
   * 模拟加载用户数据
   */
  const loadUsers = () => {
    setLoading(true);
    setError(null);
    
    // 模拟API调用延迟
    setTimeout(() => {
      try {
        setUsers(mockUsers);
        setLoading(false);
      } catch (err) {
        setError('加载用户数据失败');
        setLoading(false);
      }
    }, 500);
  };

  /**
   * 过滤和分页用户数据
   */
  const filterAndPaginateUsers = () => {
    let filtered = users;

    // 应用搜索过滤
    if (searchTerm.trim()) {
      filtered = users.filter(user => 
        user.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
        user.email.toLowerCase().includes(searchTerm.toLowerCase()) ||
        user.role.toLowerCase().includes(searchTerm.toLowerCase())
      );
    }

    // 计算分页
    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = startIndex + itemsPerPage;
    const paginatedUsers = filtered.slice(startIndex, endIndex);

    setFilteredUsers(paginatedUsers);
  };

  /**
   * 处理搜索输入变化
   */
  const handleSearchChange = (event) => {
    setSearchTerm(event.target.value);
    setCurrentPage(1); // 搜索时重置到第一页
  };

  /**
   * 处理页码变化
   */
  const handlePageChange = (pageNumber) => {
    setCurrentPage(pageNumber);
  };

  /**
   * 计算总页数
   */
  const getTotalPages = () => {
    const totalUsers = searchTerm 
      ? users.filter(user => 
          user.name.toLowerCase().includes(searchTerm.toLowerCase()) ||
          user.email.toLowerCase().includes(searchTerm.toLowerCase()) ||
          user.role.toLowerCase().includes(searchTerm.toLowerCase())
        ).length
      : users.length;
    
    return Math.ceil(totalUsers / itemsPerPage);
  };

  /**
   * 渲染分页控件
   */
  const renderPagination = () => {
    const totalPages = getTotalPages();
    
    // 如果没有数据或只有一页，不显示分页
    if (totalPages <= 1) return null;

    const pageNumbers = [];
    
    // 生成页码按钮
    for (let i = 1; i <= totalPages; i++) {
      pageNumbers.push(
        <button
          key={i}
          onClick={() => handlePageChange(i)}
          className={`page-btn ${currentPage === i ? 'active' : ''}`}
          disabled={currentPage === i}
        >
          {i}
        </button>
      );
    }

    return (
      <div className="pagination">
        <button 
          onClick={() => handlePageChange(currentPage - 1)}
          disabled={currentPage === 1}
          className="page-btn"
        >
          上一页
        </button>
        {pageNumbers}
        <button 
          onClick={() => handlePageChange(currentPage + 1)}
          disabled={currentPage === totalPages}
          className="page-btn"
        >
          下一页
        </button>
      </div>
    );
  };

  /**
   * 渲染用户列表
   */
  const renderUserList = () => {
    if (loading) {
      return <div className="loading">加载中...</div>;
    }

    if (error) {
      return <div className="error">{error}</div>;
    }

    if (filteredUsers.length === 0) {
      return <div className="no-data">暂无用户数据</div>;
    }

    return (
      <table className="user-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>姓名</th>
            <th>邮箱</th>
            <th>角色</th>
          </tr>
        </thead>
        <tbody>
          {filteredUsers.map(user => (
            <tr key={user.id}>
              <td>{user.id}</td>
              <td>{user.name}</td>
              <td>{user.email}</td>
              <td>{user.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    );
  };

  return (
    <div className="user-list-container">
      <h2>用户列表</h2>
      
      {/* 搜索框 */}
      <div className="search-container">
        <input
          type="text"
          placeholder="搜索姓名、邮箱或角色..."
          value={searchTerm}
          onChange={handleSearchChange}
          className="search-input"
        />
      </div>

      {/* 用户列表 */}
      {renderUserList()}

      {/* 分页控件 */}
      {renderPagination()}

      {/* 页面信息 */}
      <div className="page-info">
        第 {currentPage} 页，共 {getTotalPages()} 页
      </div>
    </div>
  );
}

// 样式定义
const styles = `
.user-list-container {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
  font-family: Arial, sans-serif;
}

.search-container {
  margin-bottom: 20px;
}

.search-input {
  width: 100%;
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 16px;
}

.user-table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 20px;
}

.user-table th,
.user-table td {
  border: 1px solid #ddd;
  padding: 12px;
  text-align: left;
}

.user-table th {
  background-color: #f5f5f5;
  font-weight: bold;
}

.loading, .error, .no-data {
  text-align: center;
  padding: 40px;
  color: #666;
  font-size: 16px;
}

.error {
  color: #d32f2f;
}

.pagination {
  display: flex;
  justify-content: center;
  gap: 5px;
  margin-bottom: 20px;
}

.page-btn {
  padding: 8px 12px;
  border: 1px solid #ddd;
  background-color: white;
  cursor: pointer;
  border-radius: 4px;
}

.page-btn:hover:not(:disabled) {
  background-color: #f0f0f0;
}

.page-btn.active {
  background-color: #1976d2;
  color: white;
  border-color: #1976d2;
}

.page-btn:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

.page-info {
  text-align: center;
  color: #666;
  font-size: 14px;
}
`;

// 创建样式元素
const styleSheet = document.createElement('style');
styleSheet.innerText = styles;
document.head.appendChild(styleSheet);

// 使用示例
function App() {
  return (
    <div>
      <UserList />
    </div>
  );
}

// 渲染应用
ReactDOM.render(<App />, document.getElementById('root'));
```

## 代码说明

这个 React 组件实现了以下功能：

### 主要特性：
1. **搜索功能**：支持按姓名、邮箱、角色搜索用户
2. **分页功能**：支持分页浏览用户数据
3. **状态管理**：使用 React Hooks 管理组件状态
4. **错误处理**：包含加载状态和错误处理
5. **边界情况处理**：处理空数据、搜索无结果等情况

### 核心逻辑：
- **数据过滤**：根据搜索关键词实时过滤用户数据
- **分页计算**：动态计算总页数和当前页数据
- **状态同步**：搜索时自动重置到第一页

### 使用方式：
1. 在 HTML 中创建一个 `div` 元素，id 为 `root`
2. 引入 React 和 ReactDOM 库
3. 直接使用 `<UserList />` 组件

### 最佳实践体现：
- 使用有意义的变量名和函数名
- 组件功能分离，职责单一
- 包含必要的错误边界处理
- 添加详细的中文注释说明
- 考虑性能和用户体验

这个组件可以直接在支持 React 的环境中使用，提供了完整的用户列表管理功能。[0m
