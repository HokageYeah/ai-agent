额:\\")\\npayment_groups = {}\\nfor order in orders:\\n    method = order[\'payment_method\'] if order[\'payment_method\'] else \'未支付\'\\n    if method not in payment_groups:\\n        payment_groups[method] = []\\n    payment_groups[method].append(order[\'total_amount\'])\\n\\nfor method, amounts_list in payment_groups.items():\\n    if len(amounts_list) > 0:\\n        avg = statistics.mean(amounts_list)\\n        print(f\\"{method}: {avg:.2f}元 ({len(amounts_list)}单)\\")\\n\\n# 客户复购分析\\nprint(\\"\\\\n=== 客户复购分析 ===\\")\\n# 计算每个客户的订单数量\\ncustomer_orders = {}\\nfor order in orders:\\n    customer_id = (order[\'shipping_address\'], order[\'payment_method\'])  # 使用地址+支付方式识别客户\\n    if customer_id not in customer_orders:\\n        customer_orders[customer_id] = []\\n    customer_orders[customer_id].append(order)\\n\\nrepeat_customers = {cid: orders for cid, orders in customer_orders.items() if len(orders) > 1}\\nprint(f\\"复购客户数量: {len(repeat_customers)}\\")\\nfor cid, customer_orders_list in repeat_customers.items():\\n    total_spent = sum(order[\'total_amount\'] for order in customer_orders_list)\\n    print(f\\"客户({cid[0][:6]}...): {len(customer_orders_list)}单, 总消费{total_spent:.2f}元\\")\\n\\n# 订单金额分布特征\\nprint(\\"\\\\n=== 金额分布特征 ===\\")\\n# 计算偏度和峰度（简化版）\\ndef calculate_skewness(data):\\n    n = len(data)\\n    mean = statistics.mean(data)\\n    stdev = statistics.stdev(data)\\n    skew = sum([(x - mean) ** 3 for x in data]) / (n * stdev ** 3)\\n    return skew\\n\\ndef calculate_kurtosis(data):\\n    n = len(data)\\n    mean = statistics.mean(data)\\n    stdev = statistics.stdev(data)\\n    kurt = sum([(x - mean) ** 4 for x in data]) / (n * stdev ** 4) - 3\\n    return kurt\\n\\nskew = calculate_skewness(amounts)\\nkurt = calculate_kurtosis(amounts)\\n\\nprint(f\\"金额分布偏度: {skew:.2f}\\")\\nprint(f\\"金额分布峰度: {kurt:.2f}\\")\\n\\nif skew > 0.5:\\n    print(\\"→ 金额分布右偏，存在较多高额订单\\")\\nelif skew < -0.5:\\n    print(\\"→ 金额分布左偏，存在较多低额订单\\")\\nelse:\\n    print(\\"→ 金额分布相对对称\\")\\n\\nif kurt > 0:\\n    print(\\"→ 金额分布尖峰，订单金额相对集中\\")\\nelse:\\n    print(\\"→ 金额分布平峰，订单金额较为分散\\")\\n\\n# 业务健康度指标\\nprint(\\"\\\\n=== 业务健康度指标 ===\\")\\ncompleted_orders = len([o for o in orders if o[\'status\'] in [\'delivered\', \'shipped\']])\\npaid_orders = len([o for o in orders if o[\'payment_status\'] == \'paid\'])\\ncancelled_orders = len([o for o in orders if o[\'status\'] == \'cancelled\'])\\n\\nprint(f\\"订单完成率: {completed_orders/len(orders)*100:.1f}%\\")\\nprint(f\\"支付成功率: {paid_orders/len(orders)*100:.1f}%\\")\\nprint(f\\"订单取消率: {cancelled_orders/len(orders)*100:.1f}%\\")"}', 'name': 'python_executor'}, 'type': 'function', 'index': 0}]}}][0m
