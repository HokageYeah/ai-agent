\\n退款状态分布:\\")\\nfor status, count in status_counts.items():\\n    print(f\\"  {status}: {count} 笔\\")\\n\\n# 退款类型分布\\nrefund_type_counts = {}\\nfor record in refund_data:\\n    refund_type = record[\'refund_type\']\\n    refund_type_counts[refund_type] = refund_type_counts.get(refund_type, 0) + 1\\n\\nprint(f\\"\\\\n退款类型分布:\\")\\nfor refund_type, count in refund_type_counts.items():\\n    print(f\\"  {refund_type}: {count} 笔\\")\\n\\n# 3. 趋势分析\\nprint(\\"\\\\n3. 趋势分析\\")\\nprint(\\"退款申请时间趋势:\\")\\nfor record in refund_data:\\n    apply_time = record[\'apply_at\']\\n    print(f\\"  {apply_time}: {record[\'amount\']}元 - {record[\'reason\'][:20]}...\\")\\n\\n# 处理时长分析\\nprint(\\"\\\\n退款处理时长分析:\\")\\nprocessed_count = 0\\ntotal_processing_hours = 0\\nmin_time = float(\'inf\')\\nmax_time = 0\\n\\nfor record in refund_data:\\n    if record[\'processed_at\']:\\n        apply_time = datetime.strptime(record[\'apply_at\'], \'%Y-%m-%d %H:%M:%S\')\\n        processed_time = datetime.strptime(record[\'processed_at\'], \'%Y-%m-%d %H:%M:%S\')\\n        processing_hours = (processed_time - apply_time).total_seconds() / 3600\\n        \\n        total_processing_hours += processing_hours\\n        min_time = min(min_time, processing_hours)\\n        max_time = max(max_time, processing_hours)\\n        processed_count += 1\\n        \\n        print(f\\"  订单{record[\'order_id\']}: {processing_hours:.1f} 小时\\")\\n\\nif processed_count > 0:\\n    avg_time = total_processing_hours / processed_count\\n    print(f\\"\\\\n  平均处理时长: {avg_time:.1f} 小时\\")\\n    print(f\\"  最短处理时长: {min_time:.1f} 小时\\")\\n    print(f\\"  最长处理时长: {max_time:.1f} 小时\\")\\n\\n# 4. 异常检测\\nprint(\\"\\\\n4. 异常检测\\")\\n\\n# 检测异常高额退款\\nmean_amount = statistics.mean(amounts)\\nstd_amount = statistics.stdev(amounts)\\nthreshold = mean_amount + 2 * std_amount\\n\\nhigh_refunds = [record for record in refund_data if record[\'amount\'] > threshold]\\nif high_refunds:\\n    print(f\\"检测到高额退款 (>{threshold:.2f}元):\\")\\n    