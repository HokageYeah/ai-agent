# 二叉树遍历实现 - FastAPI 应用

```python
"""
二叉树遍历实现
支持前序、中序、后序遍历的递归和迭代两种方式
使用 FastAPI 框架提供 REST API 接口
"""

from typing import List, Optional, Dict, Any
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel

# 创建 FastAPI 应用实例
app = FastAPI(
    title="二叉树遍历服务",
    description="提供二叉树前序、中序、后序遍历的递归和迭代实现",
    version="1.0.0"
)

class TreeNode:
    """二叉树节点类"""
    def __init__(self, val: int = 0, left: Optional['TreeNode'] = None, right: Optional['TreeNode'] = None):
        self.val = val
        self.left = left
        self.right = right

class TreeInput(BaseModel):
    """树输入模型 - 使用列表表示完全二叉树（层序遍历）"""
    tree: List[Optional[int]]
    
    class Config:
        schema_extra = {
            "example": {
                "tree": [1, 2, 3, 4, 5, None, None]
            }
        }

class TraversalResult(BaseModel):
    """遍历结果模型"""
    result: List[int]
    
    class Config:
        schema_extra = {
            "example": {
                "result": [1, 2, 4, 5, 3]
            }
        }

def build_tree_from_list(values: List[Optional[int]]) -> Optional[TreeNode]:
    """从列表构建二叉树（层序遍历格式）
    Args:
        values: 层序遍历的节点值列表，None 表示空节点
    Returns:
        TreeNode: 构建的二叉树根节点
    """
    if not values or values[0] is None:
        return None
    
    root = TreeNode(values[0])
    queue = [root]
    i = 1
    
    while queue and i < len(values):
        node = queue.pop(0)
        
        # 处理左子节点
        if i < len(values) and values[i] is not None:
            node.left = TreeNode(values[i])
            queue.append(node.left)
        i += 1
        
        # 处理右子节点
        if i < len(values) and values[i] is not None:
            node.right = TreeNode(values[i])
            queue.append(node.right)
        i += 1
    
    return root

# ==================== 递归实现 ====================

def preorder_traversal_recursive(root: Optional[TreeNode]) -> List[int]:
    """前序遍历 - 递归实现
    遍历顺序：根 -> 左 -> 右
    时间复杂度: O(n)
    空间复杂度: O(h) - h为树的高度（递归栈空间）
    """
    if not root:
        return []
    
    result = [root.val]
    result.extend(preorder_traversal_recursive(root.left))
    result.extend(preorder_traversal_recursive(root.right))
    return result

def inorder_traversal_recursive(root: Optional[TreeNode]) -> List[int]:
    """中序遍历 - 递归实现
    遍历顺序：左 -> 根 -> 右
    时间复杂度: O(n)
    空间复杂度: O(h) - h为树的高度（递归栈空间）
    """
    if not root:
        return []
    
    result = []
    result.extend(inorder_traversal_recursive(root.left))
    result.append(root.val)
    result.extend(inorder_traversal_recursive(root.right))
    return result

def postorder_traversal_recursive(root: Optional[TreeNode]) -> List[int]:
    """后序遍历 - 递归实现
    遍历顺序：左 -> 右 -> 根
    时间复杂度: O(n)
    空间复杂度: O(h) - h为树的高度（递归栈空间）
    """
    if not root:
        return []
    
    result = []
    result.extend(postorder_traversal_recursive(root.left))
    result.extend(postorder_traversal_recursive(root.right))
    result.append(root.val)
    return result

# ==================== 迭代实现 ====================

def preorder_traversal_iterative(root: Optional[TreeNode]) -> List[int]:
    """前序遍历 - 迭代实现
    使用栈来模拟递归过程
    时间复杂度: O(n)
    空间复杂度: O(h) - h为树的高度
    """
    if not root:
        return []
    
    result = []
    stack = [root]
    
    while stack:
        node = stack.pop()
        result.append(node.val)
        
        # 先压入右子树，再压入左子树（因为栈是后进先出）
        if node.right:
            stack.append(node.right)
        if node.left:
            stack.append(node.left)
    
    return result

def inorder_traversal_iterative(root: Optional[TreeNode]) -> List[int]:
    """中序遍历 - 迭代实现
    使用栈来模拟递归过程
    时间复杂度: O(n)
    空间复杂度: O(h) - h为树的高度
    """
    if not root:
        return []
    
    result = []
    stack = []
    current = root
    
    while stack or current:
        # 一直向左走到底，将路径上的所有节点入栈
        while current:
            stack.append(current)
            current = current.left
        
        # 处理栈顶节点（最左边的节点）
        current = stack.pop()
        result.append(current.val)
        # 转向右子树
        current = current.right
    
    return result

def postorder_traversal_iterative(root: Optional[TreeNode]) -> List[int]:
    """后序遍历 - 迭代实现
    使用两个栈的方法：
    1. 第一个栈用于遍历
    2. 第二个栈用于存储结果顺序
    时间复杂度: O(n)
    空间复杂度: O(n)
    """
    if not root:
        return []
    
    result = []
    stack1 = [root]  # 用于遍历的栈
    stack2 = []      # 用于存储结果的栈
    
    # 第一个栈的遍历顺序：根 -> 右 -> 左
    while stack1:
        node = stack1.pop()
        stack2.append(node)
        
        # 先压入左子树，再压入右子树
        # 这样在stack1中右子树会先被处理
        if node.left:
            stack1.append(node.left)
        if node.right:
            stack1.append(node.right)
    
    # 从第二个栈中弹出元素，得到后序遍历结果：左 -> 右 -> 根
    while stack2:
        result.append(stack2.pop().val)
    
    return result

# ==================== FastAPI 路由 ====================

@app.post("/traversal/preorder/recursive", response_model=TraversalResult)
async def preorder_recursive_api(tree_input: TreeInput):
    """前序遍历 - 递归实现 API"""
    try:
        root = build_tree_from_list(tree_input.tree)
        result = preorder_traversal_recursive(root)
        return TraversalResult(result=result)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"处理失败: {str(e)}")

@app.post("/traversal/preorder/iterative", response_model=TraversalResult)
async def preorder_iterative_api(tree_input: TreeInput):
    """前序遍历 - 迭代实现 API"""
    try:
        root = build_tree_from_list(tree_input.tree)
        result = preorder_traversal_iterative(root)
        return TraversalResult(result=result)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"处理失败: {str(e)}")

@app.post("/traversal/inorder/recursive", response_model=TraversalResult)
async def inorder_recursive_api(tree_input: TreeInput):
    """中序遍历 - 递归实现 API"""
    try:
        root = build_tree_from_list(tree_input.tree)
        result = inorder_traversal_recursive(root)
        return TraversalResult(result=result)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"处理失败: {str(e)}")

@app.post("/traversal/inorder/iterative", response_model=TraversalResult)
async def inorder_iterative_api(tree_input: TreeInput):
    """中序遍历 - 迭代实现 API"""
    try:
        root = build_tree_from_list(tree_input.tree)
        result = inorder_traversal_iterative(root)
        return TraversalResult(result=result)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"处理失败: {str(e)}")

@app.post("/traversal/postorder/recursive", response_model=TraversalResult)
async def postorder_recursive_api(tree_input: TreeInput):
    """后序遍历 - 递归实现 API"""
    try:
        root = build_tree_from_list(tree_input.tree)
        result = postorder_traversal_recursive(root)
        return TraversalResult(result=result)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"处理失败: {str(e)}")

@app.post("/traversal/postorder/iterative", response_model=TraversalResult)
async def postorder_iterative_api(tree_input: TreeInput):
    """后序遍历 - 迭代实现 API"""
    try:
        root = build_tree_from_list(tree_input.tree)
        result = postorder_traversal_iterative(root)
        return TraversalResult(result=result)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"处理失败: {str(e)}")

# ==================== 使用示例 ====================

"""
使用示例:

1. 安装依赖:
   pip install fastapi uvicorn

2. 启动服务:
   uvicorn main:app --reload

3. 访问 Swagger UI:
   http://localhost:8000/docs

4. API 调用示例:
   POST http://localhost:8000/traversal/preorder/recursive
   Content-Type: application/json
   Body: {"tree": [1, 2, 3, 4, 5, null, null]}

   对应的二叉树结构:
       1
      / \
     2   3
    / \
   4   5

   前序遍历结果: [1, 2, 4, 5, 3]
   中序遍历结果: [4, 2, 5, 1, 3]
   后序遍历结果: [4, 5, 2, 3, 1]

5. 边界情况测试:
   - 空树: {"tree": []} 或 {"tree": [null]}
   - 单节点: {"tree": [1]}
   - 只有左子树: {"tree": [1, 2, null, 3]}
   - 只有右子树: {"tree": [1, null, 2, null, null, 3]}
"""

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8000)
```

## 代码说明

### 主要特性

1. **完整的遍历实现**：提供了前序、中序、后序遍历的递归和迭代两种实现方式
2. **FastAPI 集成**：通过 REST API 提供服务，支持 JSON 输入输出
3. **边界情况处理**：
   - 空树处理
   - 单节点树
   - 不平衡树（只有左子树或右子树）
4. **输入格式**：使用层序遍历的列表格式表示二叉树，`null` 表示空节点
5. **错误处理**：包含异常处理和 HTTP 错误响应

### 算法复杂度

- **时间复杂度**：所有遍历方法都是 O(n)，其中 n 是树中节点的数量
- **空间复杂度**：
  - 递归实现：O(h)，h 是树的高度（递归调用栈）
  - 迭代实现：O(h) 或 O(n)，取决于具体实现

### 使用方法

1. 安装依赖：`pip install fastapi uvicorn`
2. 保存代码为 `main.py`
3. 启动服务：`uvicorn main:app --reload`
4. 访问 `http://localhost:8000/docs` 查看交互式 API 文档

这个实现遵循了 Python 编码规范（PEP 8），包含了详细的中文注释，处理了各种边界情况，并提供了完整的使用示例。[0m
