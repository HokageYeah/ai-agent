utf-8\')\\n    \\n    # 添加邮件正文\\n    message.attach(MIMEText(email_content, \'plain\', \'utf-8\'))\\n    \\n    try:\\n        # 连接SMTP服务器\\n        server = smtplib.SMTP(smtp_server, smtp_port)\\n        server.starttls()  # 启用TLS加密\\n        server.login(sender_email, sender_password)\\n        \\n        # 发送邮件\\n        server.sendmail(sender_email, receiver_email, message.as_string())\\n        server.quit()\\n        \\n        print(\\"邮件发送成功！\\")\\n        print(f\\"收件人：{receiver_email}\\")\\n        print(f\\"主题：{subject}\\")\\n        \\n    except Exception as e:\\n        print(f\\"邮件发送失败：{e}\\")\\n        print(\\"\\\\\\\\n请检查：\\")\\n        print(\\"1. 发件人邮箱是否正确\\")\\n        print(\\"2. 授权码是否正确（不是QQ密码）\\")\\n        print(\\"3. 网络连接是否正常\\")\\n        print(\\"4. SMTP服务是否已开启\\")\\n\\nif __name__ == \\"__main__\\":\\n    send_order_email()\\n```\\n\\n**使用说明：**\\n1. 将上述代码保存为 `send_order_email.py`\\n2. 修改 `sender_email` 为您的QQ邮箱\\n3. 修改 `sender_password` 为您的QQ邮箱授权码（在QQ邮箱设置中获取）\\n4. 运行脚本：`python send_order_email.py`\\n\\n**邮件内容包含的订单详情：**\\n- 订单号：1003\\n- 订单状态：已送达\\n- 支付状态：已退款\\n- 订单总金额：3499.0元\\n- 实付金额：3199.0元\\n- 优惠金额：300.0元\\n- 商品：小米电视 65寸 4K，1台\\n- 客户：王磊，电话13700137003\\n- 收货地址：广州市天河区珠江新城\\n- 快递单号：ZT5566778899\\n- 备注：618活动优惠",\n    "step_results": [\n      {\n        "success": true,\n        "result": "主题：订单确认与详情通知\\n\\n尊敬的客户：\\n\\n感谢您选择我们的服务。您的订单已成功提交并确认。为确保您准确了解订单信息，现将相关详情提供如下：\\n\\n**订单基本信息**  \\n订单编号：[订单号]  \\n下单日期：[日期]  \\n订单状态：已确认  \\n\\n**订购商品/服务详情**  \\n[商品/服务名称]  \\n数量：[数量]  \\n单价：[单价]  \\n小计金额：[金额]  \\n\\n**费用摘要**  \\n商品总额：[金额]  \\n运费（如适用）：[金额]  \\n折扣/优惠（如适用）：-[金额]  \\n订单总计：[金额]  \\n\\n**配送信息\n...（内容已截断）\n\n请根据以上数据，用清晰、友好的自然语言回答用户的任务需求。\n要求：\n1. 直接给出具体数据，不要使用 [xxx] 这样的占位符\n2. 信息完整，涵盖用户关心的所有字段\n3. 格式清晰，必要时使用列表或分段展示\n4. 如果数据中有错误或空值，如实告知\n5. 【重要防幻觉】如果任务包含“写入本地文件/保存到文件”等需求，你必须**严格检查上方数据中是否有 `file_write` 工具的执行成功结果**。\n   - 如果**有** `file_write` 工具且执行成功：说明写入成功、写入路径与写入内容来源。\n   - 如果**没有** `file_write` 工具的结果：你**绝对不能**说"已入写本地文件"或"已保存到文件"。对于只有 `text_writi