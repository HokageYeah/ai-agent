          </div>\\n            <div class=\\"c_list transi-up delay-05 \\">\\n                <ul>\\n                    <li class=\\"cur\\">\\n                        电影\\n                    </li>\\n                    <li>\\n                        电视剧\\n                    </li>\\n                    <li>\\n                        综艺\\n                    </li>\\n                    <li>\\n                        少儿\\n                    </li>\\n                    <li>\\n                        体育\\n                    </li>\\n                </ul>\\n            </div>\\n        </div>\\n        <div class=\\"section section-movie\\">\\n            <div class=\\"movie-con \\">\\n                <ul class=\\"J_movieImg\\">\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_1.png\\"></li>\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_2.png\\"></li>\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_3.png\\"></li>\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_4.png\\"></li>\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_5.png\\"></li>\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_6.png\\"></li>\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_7.png\\"></li>\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_8.png\\"></li>\\n                                            <li class=\\"slider\\"><img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/movie_9.png\\"></li>\\n          