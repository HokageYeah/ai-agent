            arr[i], arr[j] = arr[j], arr[i]\n    \n    arr[i + 1], arr[high] = arr[high], arr[i + 1]\n    return i + 1\n```\n\n### 3. 测试用例\n\n```python\ndef test_quicksort():\n    """\n    测试快速排序算法的测试用例\n    """\n    print("测试快速排序算法:")\n    \n    # 测试用例1: 普通情况\n    test1 = [64, 34, 25, 12, 22, 11, 90]\n    print(f"测试1 - 原始数组: {test1}")\n    result1 = quicksort(test1.copy())\n    print(f"测试1 - 排序结果: {result1}")\n    print(f"测试1 - 是否正确排序: {result1 == sorted(test1)}")\n    print()\n    \n    # 测试用例2: 空数组\n    test2 = []\n    print(f"测试2 - 空数组: {test2}")\n    result2 = quicksort(test2.copy())\n    print(f"测试2 - 排序结果: {result2}")\n    print(f"测试2 - 是否正确排序: {result2 == sorted(test2)}")\n    print()\n    \n    # 测试用例3: 单个元素\n    test3 = [5]\n    print(f"测试3 - 单个元素: {test3}")\n    result3 = quicksort(test3.copy())\n    print(f"测试3 - 排序结果: {result3}")\n    print(f"测试3 - 是否正确排序: {result3 == sorted(test3)}")\n    print()\n    \n    # 测试用例4: 已排序数组\n    test4 = [1, 2, 3, 4, 5]\n    print(f"测试4 - 已排序数组: {test4}")\n    result4 = quicksort(test4.copy())\n    print(f"测试4 - 排序结果: {result4}")\n    print(f"测试4 - 是否正确排序: {result4 == sorted(test4)}")\n    print()\n    \n    # 测试用例5: 逆序数组\n    test5 = [5, 4, 3, 2, 1]\n    print(f"测试5 - 逆序数组: {test5}")\n    result5 = quicksort(test5.copy())\n    print(f"测试5 - 排序结果: {result5}")\n    print(f"测试5 - 是否正确排序: {result5 == sorted(test5)}")\n    print()\n    \n    # 测试用例6: 包含重复元素\n    test6 = [3, 1, 4, 1, 5, 9, 2, 6, 5]\n    print(f"测试6 - 包含重复元素: {test6}")\n    result6 = quicksort(test6.copy())\n    print(f"测试6 - 排序结果: {result6}")\n    print(f"测试6 - 是否正确排序: {result6 == sorted(test6)}")\n```\n\n## 算法特点\n\n- **时间复杂度**：平均 O(n log n)，最坏 O(n²)\n- **空间复杂度**：标准版本 O(n)，原地版本 O(log n)\n- **稳定性**：不稳定排序算法\n- **适用场景**：大数据集排序，内存敏感场景\n\n您可以直接复制这些代码到Python环境中运行，测试函数会验证算法的正确性。', 'refusal': None, 'role': 'assistant', 'annotations': None, 'audio': None, 'function_call': None, 'tool_calls': []}}][0m
