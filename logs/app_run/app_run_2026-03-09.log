mitv4s/55/ai.mp4\\" loop></video>\\n            </div>\\n        </div>\\n        <div class=\\"section section-video\\">\\n            <div class=\\"video-out\\">\\n                <div class=\\"video-left transi-up delay-05\\">\\n                    <div class=\\"left-t \\">\\n                        <img data-src=\\"//i1.mifile.cn/f/i/18/mitv4s/55/video-left.jpg\\" alt=\\"\\" class=\\"bg\\">\\n                        <div class=\\"video-control\\">\\n                            <div>\\n                                <i class=\\"i-item-1\\"></i>\\n                                <i class=\\"i-item-2\\"></i>\\n                                <i class=\\"i-item-3\\"></i>\\n                                <i class=\\"i-item-4\\"></i>\\n                            </div>\\n                        </div>\\n                        <div class=\\"content-wrap\\">\\n                            <ul class=\\"c-text font-506l\\">\\n                                <li>&quot;我想看动作片&quot;</li>\\n                                <li>&quot;我想看胡歌的电视剧&quot;</li>\\n                                <li>&quot;我想看小猪佩奇&quot;</li>\\n                                <li>&quot;快进到第54分21秒&quot;</li>\\n                                <li>&quot;10分钟后关机&quot;</li>\\n                                <li>&quot;明天北京的天气怎么样&quot;</li>\\n                                <li>\\"扫地机器人去扫地&quot;</li>\\n                            </ul>\\n                        </div>\\n                    </div>\\n                    <div class=\\"left-b\\">\\n                        <div class=\\"b-title font-512b\\">人工智能语音，一句话的事儿</div>\\n                        <div class=\\"b-des font-506l\\">\\n                            想看什么，想知道什么，<br>按住遥控器语音键说出来。<br>它同时也是家庭的智能中心，可以语音<br>控制智能设备，快来体验一下吧。</div>\\n                    </div>\\n                </div>\\n                <div class=\\"video-right\\">\\n                    <div class=\\"vr-t J_playBtn transi-up delay-05\\" data-video=\\"//v.mifile.cn/b2c-mimall-media/c19e31e44