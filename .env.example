# 作为模板（不包含敏感信息）
# 环境设置
ENVIRONMENT=development

# ============================================================================
# LLM 提供商配置
# ============================================================================
# OpenAI API Key (从 https://platform.openai.com/api-keys 获取)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (从 https://console.anthropic.com 获取)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI 基础 URL（可选，用于代理或私有部署）
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic 基础 URL（可选，用于代理或私有部署）
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# 默认使用的模型
DEFAULT_MODEL=gpt-3.5-turbo
DEFAULT_ANTHROPIC_MODEL=claude-3-haiku-20240307

# 开发环境数据库
DEV_DB_DRIVER=mysql+mysqlconnector
DEV_DB_USER=root
DEV_DB_PASSWORD=aa123456
DEV_DB_HOST=localhost
DEV_DB_PORT=3306
DEV_DB_NAME=wx_public_dev
DEV_DB_CHARSET=utf8mb4
DEV_DB_ECHO=True
DEV_DB_POOL_SIZE=5
DEV_DB_MAX_OVERFLOW=10
DEV_DB_POOL_RECYCLE=3600
DEV_DB_POOL_TIMEOUT=30

# 生产环境数据库
PROD_DB_DRIVER=mysql+mysqlconnector
PROD_DB_USER=root
PROD_DB_PASSWORD=aa123456
PROD_DB_HOST=localhost
PROD_DB_PORT=3306
PROD_DB_NAME=wx_public_prod
PROD_DB_CHARSET=utf8mb4
PROD_DB_ECHO=True
PROD_DB_POOL_SIZE=5
PROD_DB_MAX_OVERFLOW=10
PROD_DB_POOL_RECYCLE=3600
PROD_DB_POOL_TIMEOUT=30

# 测试环境数据库
TEST_DB_DRIVER=mysql+mysqlconnector
TEST_DB_USER=root
TEST_DB_PASSWORD=aa123456
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_NAME=wx_public_test
TEST_DB_CHARSET=utf8mb4
TEST_DB_ECHO=True
TEST_DB_POOL_SIZE=5
TEST_DB_MAX_OVERFLOW=10
TEST_DB_POOL_RECYCLE=3600
TEST_DB_POOL_TIMEOUT=30
